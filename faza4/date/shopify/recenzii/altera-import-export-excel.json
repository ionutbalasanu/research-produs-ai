me"}, {"id": "2063505", "rating": 5, "date": "2026-02-02", "store": "Bartisans", "meta": ["India", "About 1 hour using the app"], "text": "Amazing Apps, hard to find good free apps that are so useful on shopify these days."}, {"id": "2018815", "rating": 5, "date": "2025-12-30", "store": "Koreabe", "meta": ["South Korea", "4 months using the app"], "text": "Sooo useful, i have to thank to the creator of this app. You are the best!"}, {"id": "1982071", "rating": 5, "date": "2025-11-30", "store": "Bujak tebriz aromatics ", "meta": ["Bulgaria", "About 20 hours using the app"], "text": "Really easy to use and helpful"}, {"id": "1924588", "rating": 5, "date": "2025-10-21", "store": "secretsextoys.store", "meta": ["Greece", "About 5 hours using the app"], "text": "\"Great experience and a quick way to update product metafields\""}, {"id": "1912284", "rating": 5, "date": "2025-10-11", "store": "Whites Forestry Equipment", "meta": ["Australia", "About 2 months using the app"], "text": "If you handle bulk product data and care about precision, Altera is the tool you want. Five stars from us highly recommended."}, {"id": "1859375", "rating": 5, "date": "2025-08-30", "store": "Weewag", "meta": ["United States", "About 3 hours using the app"], "text": "keep it free forever!!"}, {"id": "1849113", "rating": 5, "date": "2025-08-22", "store": "Sarto", "meta": ["Malta", "4 months using the app"], "text": "schedule job need for exporting, we want to sync with our ERP with excel."}, {"id": "1843873", "rating": 5, "date": "2025-08-19", "store": "Beyours", "meta": ["India", "4 minutes using the app"], "text": "Amazing"}, {"id": "1839777", "rating": 5, "date": "2025-08-15", "store": "Gino Pizza Ovens", "meta": ["United Kingdom", "About 2 months using the app"], "text": "Extremely useful app! And it's free!"}, {"id": "1797432", "rating": 5, "date": "2025-07-12", "store": "Story Leather Inc.", "meta": ["United States", "3 minutes using the app"], "text": "Simple to use, super intuitive, wil